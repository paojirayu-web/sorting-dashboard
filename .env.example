# Database (existing)
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=

# ─── Daily report automation (LINE + Excel) ───────────────────
# LINE Messaging API — Bot ต้องอยู่ในกลุ่มแล้ว
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=

# รหัสลับสำหรับ n8n / cron เรียก API (สุ่มยาวๆ)
CRON_SECRET=

# URL เครื่อง production (deploy จริง) — ใช้เมื่อ cron/n8n เรียก API โดยตรง
# ตัวอย่าง: http://192.168.2.30:8021
# ลิงก์ท้ายข้อความ LINE ใช้ค่านี้เสมอ (ทั้งทดสอบบน dev และ cron บน server)
APP_BASE_URL=http://192.168.2.30:8021

# จับภาพหน้าเว็บ (Puppeteer) — ต้องชี้ server ที่รันอยู่จริง
SCREENSHOT_BASE_URL=http://127.0.0.1:8021

# ขนาดตัวอักษรในรูป LINE (zoom layout ก่อนจับภาพ — ค่าเริ่มต้น 1.65)
# LINE_SCREENSHOT_ZOOM=1.65
# LINE_SCREENSHOT_WIDTH=1400

# ส่งรูปใน LINE (ไม่ใช่ลิงก์): อัปโหลดชั่วคราวเพื่อให้ LINE ดึงรูปได้ (ค่าเริ่มต้น temp_host)
# ถ้าไม่ต้องการส่งออกนอก: ตั้ง LINE_IMAGE_PUBLIC_BASE_URL เป็น HTTPS tunnel ชี้เครื่อง .30
LINE_IMAGE_UPLOAD=temp_host

# ─── ส่ง LINE อัตโนมัติ (ตั้งเวลาได้ใน Settings → General Settings) ───
# เปิดเป็น true จนกว่าจะ Save schedule บน server (หรือมีไฟล์ data/daily-report-automation.json)
ENABLE_DAILY_REPORT_CRON=true

# ถ้า pm2 ใช้ cwd คนละโฟลเดอร์กับ production_package ให้ชี้ path เต็ม
# APP_DATA_DIR=D:\apps\sorting-dashboard\production_package
DAILY_REPORT_CRON_SCHEDULE=30 20 * * *
DAILY_REPORT_TIMEZONE=Asia/Bangkok
